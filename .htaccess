# ---------------------------------------------------------------------
# optionspa.com - flat PHP build.
#
# CANONICAL URL FORM:  /spravato-therapy
#   no .php extension, and NO trailing slash.
#
# Everything else 301s to that one form:
#   /spravato-therapy/      (old WordPress url)  -> /spravato-therapy
#   /spravato-therapy.php   (raw file)           -> /spravato-therapy
#   /category/spravato/     (old nested url)     -> /category-spravato
#
# Why no trailing slash: page assets are directory-relative
# (wp-content/...), so they resolve against the site folder. A url
# ending in / makes the browser resolve them one level deeper and every
# stylesheet and image 404s. Single-segment extensionless urls resolve
# correctly, which is why this is the canonical form.
#
# Subfolder-safe: rules that need the full path read %{THE_REQUEST},
# which always carries it from the domain root; everything else uses a
# relative substitution that Apache prefixes with the current folder.
# Nothing hardcodes a base path, so this runs at a domain root or under
# e.g. /option-live-web/ unchanged.
# ---------------------------------------------------------------------
Options -Indexes +FollowSymLinks
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# --- one canonical origin: https://www.optionspa.com -------------------
# Every http:// and non-www request 301s there in a single hop.
# Only the production domain is matched, so staging/dev hosts are untouched.
# Never add a www -> non-www redirect in the server panel or a CDN, or the
# two will loop.
RewriteCond %{HTTP_HOST} ^optionspa\.com$ [NC]
RewriteRule ^ https://www.optionspa.com%{REQUEST_URI} [R=301,L]
# http -> https on www. The X-Forwarded-Proto check keeps this from looping
# if a proxy/CDN that terminates TLS is ever put in front of the server.
RewriteCond %{HTTP_HOST} ^www\.optionspa\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://www.optionspa.com%{REQUEST_URI} [R=301,L]

# includes/ holds HTML fragments, not pages - never serve directly
RewriteRule ^includes/ - [F,L]

# --- hacked spam pages: 410 Gone (tells Google to drop them for good) --
# Casino spam categories injected by a past WordPress hack, plus an old
# 1xbet spam post. Matches the flat and old nested forms, .php, trailing
# slash and any /page/N suffix.
RewriteRule ^(category[-/]casino(-utan-svensk-licens)?|preimushchestva-i-nedostatki-1xbet-zerkalo-rabochee-na-segodnia-9)(\.php)?(/.*)?$ - [G,L,NC]

# --- home ------------------------------------------------------------
# /index.php and /index -> the folder itself (the one url that keeps its slash)
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteRule ^index/?$ ./ [R=301,L]

# --- strip .php ------------------------------------------------------
RewriteCond %{REQUEST_URI} !/(wp-content|wp-admin|wp-includes|includes)/ [NC]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- old WordPress nested urls -> flat canonical ----------------------
RewriteRule ^category/adhd/?$ category-adhd [R=301,L]
RewriteRule ^category/anxiety/?$ category-anxiety [R=301,L]
RewriteRule ^category/blog/?$ category-blog [R=301,L]
RewriteRule ^category/mental-health/?$ category-mental-health [R=301,L]
RewriteRule ^category/mental-health/page/2/?$ category-mental-health-page-2 [R=301,L]
RewriteRule ^category/ocd/?$ category-ocd [R=301,L]
RewriteRule ^category/psychotherapy/?$ therapist-in-reading-pa [R=301,L]
RewriteRule ^category/spravato/?$ category-spravato [R=301,L]
RewriteRule ^category/tms-therapy/?$ category-tms-therapy [R=301,L]
RewriteRule ^category/tms-therapy/page/2/?$ category-tms-therapy-page-2 [R=301,L]
RewriteRule ^elementor-hf/(footer|header)/?$ ./ [R=301,L]
RewriteRule ^location/reading/?$ location-reading [R=301,L]

# date archives were never exported -> home
RewriteRule ^(19|20)[0-9]{2}/[0-9]{2}/?$ ./ [R=301,L]

# /blog/page/N/ no longer exists - blog lists every post
RewriteRule ^blog/page/[0-9]+/?$ blog [R=301,L]

# Thrive pagination placeholder / single post pagination -> canonical post
RewriteRule ^counseling-center-in-reading/page(/.*)?$ counseling-center-in-reading [R=301,L]
RewriteRule ^does-tricare-cover-tms-therapy-in-reading-pa/page(/.*)?$ does-tricare-cover-tms-therapy-in-reading-pa [R=301,L]
RewriteRule ^how-does-tms-therapy-help-in-the-treatment-of-depression/page(/.*)?$ how-does-tms-therapy-help-in-the-treatment-of-depression [R=301,L]
RewriteRule ^how-tms-therapy-helps-treat-depression/page(/.*)?$ how-does-tms-therapy-help-in-the-treatment-of-depression [R=301,L]
RewriteRule ^top-10-psychiatrists-in-pennsylvania/page(/.*)?$ top-10-psychiatrists-in-pennsylvania [R=301,L]
RewriteRule ^(.*)/page(?:/.*)?$ $1 [R=301,L,NC]

# defunct WordPress REST API -> home
RewriteRule ^wp-json(?:/.*)?$ ./ [R=301,L]

# --- retired urls -> nearest live page --------------------------------
RewriteRule ^anxiety-treatment-reading-pa/?$ anxiety-treatment [R=301,L]
RewriteRule ^bipolar-affective-disorder/?$ bipolar-disorder [R=301,L]
RewriteRule ^contact-us/?$ contact [R=301,L]
RewriteRule ^depression-treatment-reading-pa/?$ depression [R=301,L]
RewriteRule ^depression-treatment/?$ depression [R=301,L]
RewriteRule ^get-started/?$ getstarted [R=301,L]
RewriteRule ^how-tms-therapy-helps-treat-depression/?$ how-does-tms-therapy-help-in-the-treatment-of-depression [R=301,L]
RewriteRule ^insurance-coverage/?$ insurances-accepted [R=301,L]
RewriteRule ^insurance-plans/?$ insurances-accepted [R=301,L]
RewriteRule ^new-blog-layout/?$ blog [R=301,L]
RewriteRule ^ocd-treatment/?$ ocd [R=301,L]
RewriteRule ^psychiatrist-in-reading-pa/?$ location-reading [R=301,L]
RewriteRule ^ptsd-treatment/?$ ptsd [R=301,L]
RewriteRule ^tms-therapy-reading-pa/?$ tms-therapy-reading [R=301,L]

# --- duplicate pages -> one main url (SEO: duplicate titles/descriptions)
# The duplicate .php files are kept in the repo but never served.
# homepage copies / template fragments / old WordPress date archives
RewriteRule ^(2026-0[5-9]|generated-homepage|elementor-hf-header|elementor-hf-footer)/?$ ./ [R=301,L]
RewriteRule ^addiction-recovery/?$ drug-addiction [R=301,L]
RewriteRule ^location/?$ location-reading [R=301,L]
# exact copies of a live page
RewriteRule ^tms-therapy/?$ tms-therapy-reading [R=301,L]
RewriteRule ^(medication-management|med-management)/?$ medication-management-options [R=301,L]
RewriteRule ^anxiety-treatment-centers-in-pennsylvania/?$ anxiety-treatment [R=301,L]
RewriteRule ^does-aetna-cover-tms-therapy-your-complete-guide-to-tms-coverage-at-options-psychiatry/?$ does-aetna-cover-tms-therapy [R=301,L]
RewriteRule ^is-anxiety-a-mood-disorder-understanding-the-difference/?$ is-anxiety-a-mood-disorder [R=301,L]
RewriteRule ^what-are-the-symptoms-of-addiction-when-should-you-seek-mental-health-support/?$ what-are-the-symptoms-of-addiction [R=301,L]
# old backup versions of live pages
RewriteRule ^blog-old/?$ blog [R=301,L]
RewriteRule ^contact-old/?$ contact [R=301,L]
RewriteRule ^dr-crawford-old/?$ dr-crawford [R=301,L]
RewriteRule ^medication-management-options-old/?$ medication-management-options [R=301,L]
RewriteRule ^tms-therapy-reading-old/?$ tms-therapy-reading [R=301,L]
RewriteRule ^thank-you-old/?$ thank-you [R=301,L]

# --- drop the trailing slash -----------------------------------------
# !-d keeps real directories (the site root) working, so no redirect loop
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)/+[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- serve the canonical url from its flat file (internal) ------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]
</IfModule>

# ErrorDocument needs a root-absolute path, which would point outside a
# subfolder install. For a domain-root deploy add:  ErrorDocument 404 /404.php

# ---------------------------------------------------------------------
# Performance: compression + far-future caching
# (On LiteSpeed these are also handled server-side; enabling Brotli in
#  CyberPanel > Server > Tweak Settings > Compression gives the best
#  results. These rules are the portable/fallback layer.)
# ---------------------------------------------------------------------
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
AddOutputFilterByType DEFLATE font/woff2 font/woff application/font-woff
</IfModule>

<IfModule mod_headers.c>
# Static assets: 30 days by default...
<FilesMatch "\.(css|js|mjs|woff2?|ttf|otf|eot|svg|webp|avif|png|jpe?g|gif|ico|mp4|webm|webmanifest)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
# ...but content-hashed build artifacts never change under the same name:
<FilesMatch "__q[0-9a-f]{6,}\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "^b_[0-9a-f]{8}\.css$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
# HTML should always revalidate (pages change; no stale marketing copy)
<FilesMatch "\.(html|php)$">
Header set Cache-Control "no-cache"
</FilesMatch>
</IfModule>
