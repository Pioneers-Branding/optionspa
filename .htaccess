# ---------------------------------------------------------------------
# optionspa.com - flat PHP build.
#
# CANONICAL URL FORM:  /spravato-therapy
#   no .php extension, and NO trailing slash.
#
# Everything else 301s to that one form:
#   /spravato-therapy/      (old WordPress url)  -> /spravato-therapy
#   /spravato-therapy.php   (raw file)           -> /spravato-therapy
#   /category/spravato/     (old nested url)     -> /category-spravato
#
# Why no trailing slash: page assets are directory-relative
# (wp-content/...), so they resolve against the site folder. A url
# ending in / makes the browser resolve them one level deeper and every
# stylesheet and image 404s. Single-segment extensionless urls resolve
# correctly, which is why this is the canonical form.
#
# Subfolder-safe: rules that need the full path read %{THE_REQUEST},
# which always carries it from the domain root; everything else uses a
# relative substitution that Apache prefixes with the current folder.
# Nothing hardcodes a base path, so this runs at a domain root or under
# e.g. /option-live-web/ unchanged.
# ---------------------------------------------------------------------
Options -Indexes +FollowSymLinks
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# includes/ holds HTML fragments, not pages - never serve directly
RewriteRule ^includes/ - [F,L]

# --- home ------------------------------------------------------------
# /index.php and /index -> the folder itself (the one url that keeps its slash)
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteRule ^index/?$ ./ [R=301,L]

# --- strip .php ------------------------------------------------------
RewriteCond %{REQUEST_URI} !/(wp-content|wp-admin|wp-includes|includes)/ [NC]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- old WordPress nested urls -> flat canonical ----------------------
RewriteRule ^2026/05/?$ 2026-05 [R=301,L]
RewriteRule ^2026/06/?$ 2026-06 [R=301,L]
RewriteRule ^2026/07/?$ 2026-07 [R=301,L]
RewriteRule ^2026/08/?$ 2026-08 [R=301,L]
RewriteRule ^category/adhd/?$ category-adhd [R=301,L]
RewriteRule ^category/anxiety/?$ category-anxiety [R=301,L]
RewriteRule ^category/blog/?$ category-blog [R=301,L]
RewriteRule ^category/casino/?$ category-casino [R=301,L]
RewriteRule ^category/casino-utan-svensk-licens/?$ category-casino-utan-svensk-licens [R=301,L]
RewriteRule ^category/mental-health/?$ category-mental-health [R=301,L]
RewriteRule ^category/mental-health/page/2/?$ category-mental-health-page-2 [R=301,L]
RewriteRule ^category/ocd/?$ category-ocd [R=301,L]
RewriteRule ^category/spravato/?$ category-spravato [R=301,L]
RewriteRule ^category/tms-therapy/?$ category-tms-therapy [R=301,L]
RewriteRule ^category/tms-therapy/page/2/?$ category-tms-therapy-page-2 [R=301,L]
RewriteRule ^elementor-hf/footer/?$ elementor-hf-footer [R=301,L]
RewriteRule ^elementor-hf/header/?$ elementor-hf-header [R=301,L]
RewriteRule ^location/reading/?$ location-reading [R=301,L]

# date archives were never exported -> home
RewriteRule ^(19|20)[0-9]{2}/[0-9]{2}/?$ ./ [R=301,L]

# /blog/page/N/ no longer exists - blog lists every post
RewriteRule ^blog/page/[0-9]+/?$ blog [R=301,L]

# --- retired urls -> nearest live page --------------------------------
RewriteRule ^anxiety-treatment-reading-pa/?$ anxiety-treatment [R=301,L]
RewriteRule ^bipolar-affective-disorder/?$ bipolar-disorder [R=301,L]
RewriteRule ^contact-us/?$ contact [R=301,L]
RewriteRule ^depression-treatment-reading-pa/?$ depression [R=301,L]
RewriteRule ^depression-treatment/?$ depression [R=301,L]
RewriteRule ^how-tms-therapy-helps-treat-depression/?$ how-does-tms-therapy-help-in-the-treatment-of-depression [R=301,L]
RewriteRule ^insurance-coverage/?$ insurances-accepted [R=301,L]
RewriteRule ^insurance-plans/?$ insurances-accepted [R=301,L]
RewriteRule ^ocd-treatment/?$ ocd [R=301,L]
RewriteRule ^psychiatrist-in-reading-pa/?$ location-reading [R=301,L]
RewriteRule ^ptsd-treatment/?$ ptsd [R=301,L]
RewriteRule ^tms-therapy-reading-pa/?$ tms-therapy-reading [R=301,L]

# --- drop the trailing slash -----------------------------------------
# !-d keeps real directories (the site root) working, so no redirect loop
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)/+[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# --- serve the canonical url from its flat file (internal) ------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]
</IfModule>

# ErrorDocument needs a root-absolute path, which would point outside a
# subfolder install. For a domain-root deploy add:  ErrorDocument 404 /404.php
