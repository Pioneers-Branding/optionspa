# ---------------------------------------------------------------------
# optionspa.com - flat PHP build with a portable base path.
#
# Assets and links in this tree are DIRECTORY-RELATIVE (wp-content/...,
# about-us.php), so it runs unchanged at a domain root or in a subfolder
# such as /option-live-web/. Nothing below hardcodes a base path.
#
# Consequence: every page must be served at a FLAT url with no trailing
# slash (/about-us.php). A trailing-slash url like /about-us/ makes the
# browser resolve wp-content/... one level too deep, so each legacy
# pretty url below REDIRECTS to the flat file rather than serving it in
# place. All substitutions are relative for the same reason - a leading
# slash would escape the subfolder.
#
# The original pretty-url ruleset is kept in .htaccess.pretty-urls. To go
# back, restore it AND rebuild the pages with root-relative paths.
# ---------------------------------------------------------------------
Options -Indexes +FollowSymLinks
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{REQUEST_FILENAME} !-d 
RewriteCond %{REQUEST_FILENAME}\.php -f 
RewriteRule ^(.*)$ $1.php

# To externally redirect /dir/foo.php to /dir/foo
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=302,L,NE]

# includes/ holds HTML fragments, not pages - never serve directly
RewriteRule ^includes/ - [F,L]

# legacy nested pretty urls -> flat file (301, so the browser url goes flat)
RewriteRule ^2026/05/?$ 2026-05.php [R=301,L]
RewriteRule ^2026/06/?$ 2026-06.php [R=301,L]
RewriteRule ^2026/07/?$ 2026-07.php [R=301,L]
RewriteRule ^2026/08/?$ 2026-08.php [R=301,L]
RewriteRule ^category/adhd/?$ category-adhd.php [R=301,L]
RewriteRule ^category/anxiety/?$ category-anxiety.php [R=301,L]
RewriteRule ^category/blog/?$ category-blog.php [R=301,L]
RewriteRule ^category/casino/?$ category-casino.php [R=301,L]
RewriteRule ^category/casino-utan-svensk-licens/?$ category-casino-utan-svensk-licens.php [R=301,L]
RewriteRule ^category/mental-health/?$ category-mental-health.php [R=301,L]
RewriteRule ^category/mental-health/page/2/?$ category-mental-health-page-2.php [R=301,L]
RewriteRule ^category/ocd/?$ category-ocd.php [R=301,L]
RewriteRule ^category/spravato/?$ category-spravato.php [R=301,L]
RewriteRule ^category/tms-therapy/?$ category-tms-therapy.php [R=301,L]
RewriteRule ^category/tms-therapy/page/2/?$ category-tms-therapy-page-2.php [R=301,L]
RewriteRule ^elementor-hf/footer/?$ elementor-hf-footer.php [R=301,L]
RewriteRule ^elementor-hf/header/?$ elementor-hf-header.php [R=301,L]
RewriteRule ^location/reading/?$ location-reading.php [R=301,L]

# date archives that were never exported -> home
RewriteRule ^(19|20)[0-9]{2}/[0-9]{2}/?$ index.php [R=301,L]

# /blog/page/N/ no longer exists - blog.php lists every post
RewriteRule ^blog/page/[0-9]+/?$ blog.php [R=301,L]

# retired urls -> nearest live page
RewriteRule ^anxiety-treatment-reading-pa/?$ anxiety-treatment.php [R=301,L]
RewriteRule ^bipolar-affective-disorder/?$ bipolar-disorder.php [R=301,L]
RewriteRule ^contact-us/?$ contact.php [R=301,L]
RewriteRule ^depression-treatment-reading-pa/?$ depression.php [R=301,L]
RewriteRule ^depression-treatment/?$ depression.php [R=301,L]
RewriteRule ^how-tms-therapy-helps-treat-depression/?$ how-does-tms-therapy-help-in-the-treatment-of-depression.php [R=301,L]
RewriteRule ^insurance-coverage/?$ insurances-accepted.php [R=301,L]
RewriteRule ^insurance-plans/?$ insurances-accepted.php [R=301,L]
RewriteRule ^ocd-treatment/?$ ocd.php [R=301,L]
RewriteRule ^psychiatrist-in-reading-pa/?$ location-reading.php [R=301,L]
RewriteRule ^ptsd-treatment/?$ ptsd.php [R=301,L]
RewriteRule ^tms-therapy-reading-pa/?$ tms-therapy-reading.php [R=301,L]
RewriteRule ^2026-05/?$ 2026-05.php [R=301,L]
RewriteRule ^2026-06/?$ 2026-06.php [R=301,L]
RewriteRule ^2026-07/?$ 2026-07.php [R=301,L]
RewriteRule ^2026-08/?$ 2026-08.php [R=301,L]
RewriteRule ^category-adhd/?$ category-adhd.php [R=301,L]
RewriteRule ^category-anxiety/?$ category-anxiety.php [R=301,L]
RewriteRule ^category-blog/?$ category-blog.php [R=301,L]
RewriteRule ^category-casino/?$ category-casino.php [R=301,L]
RewriteRule ^category-casino-utan-svensk-licens/?$ category-casino-utan-svensk-licens.php [R=301,L]
RewriteRule ^category-mental-health/?$ category-mental-health.php [R=301,L]
RewriteRule ^category-mental-health-page-2/?$ category-mental-health-page-2.php [R=301,L]
RewriteRule ^category-ocd/?$ category-ocd.php [R=301,L]
RewriteRule ^category-spravato/?$ category-spravato.php [R=301,L]
RewriteRule ^category-tms-therapy/?$ category-tms-therapy.php [R=301,L]
RewriteRule ^category-tms-therapy-page-2/?$ category-tms-therapy-page-2.php [R=301,L]
RewriteRule ^elementor-hf-footer/?$ elementor-hf-footer.php [R=301,L]
RewriteRule ^elementor-hf-header/?$ elementor-hf-header.php [R=301,L]
RewriteRule ^location-reading/?$ location-reading.php [R=301,L]

# /about-us/ -> /about-us.php   (301: strip the trailing slash so relative
# assets resolve against the site folder, not against /about-us/)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/$ $1.php [R=301,L]

# /about-us -> about-us.php     (internal: base is already the site folder)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)$ $1.php [L]
</IfModule>

# NOTE: ErrorDocument needs a root-absolute path, which would point outside
# a subfolder install, so it is left to the server default here. If this
# tree is deployed at a domain root, add:  ErrorDocument 404 /404.php
