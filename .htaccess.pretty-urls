# ---------------------------------------------------------------------
# optionspa.com - WordPress URLs served from the flat PHP build.
# Generated by make_pretty_urls.py - do not hand-edit; regenerate.
# ---------------------------------------------------------------------
Options -Indexes +FollowSymLinks
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. canonical host: www -> non-www.
#    Also fixes the www<->non-www redirect loop that made
#    /how-tms-therapy-helps-treat-depression/ unreachable.
RewriteCond %{HTTP_HOST} ^www\.optionspa\.com$ [NC]
RewriteRule ^(.*)$ https://optionspa.com/$1 [R=301,L]

# 2. includes/ holds HTML fragments, not pages - never serve directly
RewriteRule ^includes/ - [F,L]

# 3. /slug.php -> canonical URL, 301, one hop.
#
#    DO NOT replace this with the common extensionless recipe:
#        RewriteCond %{REQUEST_FILENAME} !-d
#        RewriteCond %{REQUEST_FILENAME}\.php -f
#        RewriteRule ^(.*)$ $1.php
#    It assumes URLs have NO trailing slash. Ours do. Apache resolves
#    REQUEST_FILENAME for /dr-crawford/ as .../dr-crawford (slash
#    stripped), so the -f test passes, and the rule then appends .php to
#    a URI that still ends in / :
#        dr-crawford/ -> dr-crawford/.php -> dr-crawford/.php.php -> ...
#    until Apache aborts with a 500. Adding [L] does not help - the
#    conditions still pass on every pass. Rules 6/7 below already do this
#    job correctly for trailing-slash URLs.
#
#    Every rule here is guarded on %{THE_REQUEST}: the original request
#    line, which internal rewrites never touch. Without that guard rule 7
#    rewrites /dr-crawford/ to dr-crawford.php, that re-enters the ruleset,
#    and an unguarded .php rule redirects it straight back - a loop.
RewriteCond %{THE_REQUEST} \s/+index\.php[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+2026-05\.php[\s?] [NC]
RewriteRule ^ /2026/05/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+2026-06\.php[\s?] [NC]
RewriteRule ^ /2026/06/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+2026-07\.php[\s?] [NC]
RewriteRule ^ /2026/07/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+2026-08\.php[\s?] [NC]
RewriteRule ^ /2026/08/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+category-adhd\.php[\s?] [NC]
RewriteRule ^ /category/adhd/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+category-anxiety\.php[\s?] [NC]
RewriteRule ^ /category/anxiety/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+category-blog\.php[\s?] [NC]
RewriteRule ^ /category/blog/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+category-casino\.php[\s?] [NC]
RewriteRule ^ /category/casino/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+category-casino-utan-svensk-licens\.php[\s?] [NC]
RewriteRule ^ /category/casino-utan-svensk-licens/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+category-mental-health\.php[\s?] [NC]
RewriteRule ^ /category/mental-health/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+category-mental-health-page-2\.php[\s?] [NC]
RewriteRule ^ /category/mental-health/page/2/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+category-ocd\.php[\s?] [NC]
RewriteRule ^ /category/ocd/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+category-spravato\.php[\s?] [NC]
RewriteRule ^ /category/spravato/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+category-tms-therapy\.php[\s?] [NC]
RewriteRule ^ /category/tms-therapy/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+category-tms-therapy-page-2\.php[\s?] [NC]
RewriteRule ^ /category/tms-therapy/page/2/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+elementor-hf-footer\.php[\s?] [NC]
RewriteRule ^ /elementor-hf/footer/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+elementor-hf-header\.php[\s?] [NC]
RewriteRule ^ /elementor-hf/header/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+location-reading\.php[\s?] [NC]
RewriteRule ^ /location/reading/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.php[\s?] [NC]
RewriteRule ^ /%1/ [R=301,L]

# 4. retired URLs that 404 on the live site -> nearest live page
RewriteRule ^anxiety-treatment-reading-pa/?$ /anxiety-treatment/ [R=301,L]
RewriteRule ^bipolar-affective-disorder/?$ /bipolar-disorder/ [R=301,L]
RewriteRule ^contact-us/?$ /contact/ [R=301,L]
RewriteRule ^depression-treatment-reading-pa/?$ /depression/ [R=301,L]
RewriteRule ^depression-treatment/?$ /depression/ [R=301,L]
RewriteRule ^how-tms-therapy-helps-treat-depression/?$ /how-does-tms-therapy-help-in-the-treatment-of-depression/ [R=301,L]
RewriteRule ^insurance-coverage/?$ /insurances-accepted/ [R=301,L]
RewriteRule ^insurance-plans/?$ /insurances-accepted/ [R=301,L]
RewriteRule ^ocd-treatment/?$ /ocd/ [R=301,L]
RewriteRule ^psychiatrist-in-reading-pa/?$ /location/reading/ [R=301,L]
RewriteRule ^ptsd-treatment/?$ /ptsd/ [R=301,L]
RewriteRule ^tms-therapy-reading-pa/?$ /tms-therapy-reading/ [R=301,L]

# 5. nested URLs. A generic rule cannot express these: /category/adhd/
#    must reach category-adhd.php, not category/adhd.php.
#    Only one direction here: WP URL -> flat file. The .php -> WP URL
#    direction is left to the external rule (see note 3).
#
#    First: the flat *filename* used as a URL (/category-adhd/) would
#    otherwise be served by rules 6/7 as a second, non-canonical copy of
#    the same page. Send it to the real URL instead.
RewriteRule ^2026-05/?$ /2026/05/ [R=301,L]
RewriteRule ^2026-06/?$ /2026/06/ [R=301,L]
RewriteRule ^2026-07/?$ /2026/07/ [R=301,L]
RewriteRule ^2026-08/?$ /2026/08/ [R=301,L]
RewriteRule ^category-adhd/?$ /category/adhd/ [R=301,L]
RewriteRule ^category-anxiety/?$ /category/anxiety/ [R=301,L]
RewriteRule ^category-blog/?$ /category/blog/ [R=301,L]
RewriteRule ^category-casino/?$ /category/casino/ [R=301,L]
RewriteRule ^category-casino-utan-svensk-licens/?$ /category/casino-utan-svensk-licens/ [R=301,L]
RewriteRule ^category-mental-health/?$ /category/mental-health/ [R=301,L]
RewriteRule ^category-mental-health-page-2/?$ /category/mental-health/page/2/ [R=301,L]
RewriteRule ^category-ocd/?$ /category/ocd/ [R=301,L]
RewriteRule ^category-spravato/?$ /category/spravato/ [R=301,L]
RewriteRule ^category-tms-therapy/?$ /category/tms-therapy/ [R=301,L]
RewriteRule ^category-tms-therapy-page-2/?$ /category/tms-therapy/page/2/ [R=301,L]
RewriteRule ^elementor-hf-footer/?$ /elementor-hf/footer/ [R=301,L]
RewriteRule ^elementor-hf-header/?$ /elementor-hf/header/ [R=301,L]
RewriteRule ^location-reading/?$ /location/reading/ [R=301,L]

RewriteRule ^2026/05/?$ 2026-05.php [L]
RewriteRule ^2026/06/?$ 2026-06.php [L]
RewriteRule ^2026/07/?$ 2026-07.php [L]
RewriteRule ^2026/08/?$ 2026-08.php [L]
RewriteRule ^(19|20)[0-9]{2}/[0-9]{2}/?$ / [R=301,L]
RewriteRule ^blog/page/[0-9]+/?$ /blog/ [R=301,L]
RewriteRule ^category/adhd/?$ category-adhd.php [L]
RewriteRule ^category/anxiety/?$ category-anxiety.php [L]
RewriteRule ^category/blog/?$ category-blog.php [L]
RewriteRule ^category/casino/?$ category-casino.php [L]
RewriteRule ^category/casino-utan-svensk-licens/?$ category-casino-utan-svensk-licens.php [L]
RewriteRule ^category/mental-health/?$ category-mental-health.php [L]
RewriteRule ^category/mental-health/page/2/?$ category-mental-health-page-2.php [L]
RewriteRule ^category/ocd/?$ category-ocd.php [L]
RewriteRule ^category/spravato/?$ category-spravato.php [L]
RewriteRule ^category/tms-therapy/?$ category-tms-therapy.php [L]
RewriteRule ^category/tms-therapy/page/2/?$ category-tms-therapy-page-2.php [L]
RewriteRule ^elementor-hf/footer/?$ elementor-hf-footer.php [L]
RewriteRule ^elementor-hf/header/?$ elementor-hf-header.php [L]
RewriteRule ^location/reading/?$ location-reading.php [L]

# 6. flat pages: /dr-crawford -> /dr-crawford/  (enforce trailing slash)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([^/]+)$ /$1/ [R=301,L]

# 7. flat pages: /dr-crawford/ -> dr-crawford.php  (internal, no redirect)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([^/]+)/$ $1.php [L]
</IfModule>

ErrorDocument 404 /404.php
